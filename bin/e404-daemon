#!/system/bin/sh
#
# E404 Auto-Game & Battery Saver Daemon
# Monitors foreground applications & ROM battery saver state via system_monitor and inotify.
#

if [ -d "/data/adb/modules/e404_controller" ]; then
    MODDIR="/data/adb/modules/e404_controller"
else
    MODDIR="$(cd "$(dirname "$0")/.." 2>/dev/null && pwd)"
fi

CONF_DIR="$MODDIR/config"
CTRL="$MODDIR/bin/e404-ctrl"
SYS_OUT="$CONF_DIR/sysmon_out.txt"
LOCK_FILE="$CONF_DIR/sysmon.lock"
GAMELIST="$CONF_DIR/gamelist.txt"
STATE_FILE="$CONF_DIR/daemon_state"
CONF_FILE="$CONF_DIR/e404.conf"
LOG_FILE="$CONF_DIR/daemon.log"

BUSYBOX="/data/adb/ksu/bin/busybox"
[ ! -x "$BUSYBOX" ] && BUSYBOX="/data/adb/magisk/busybox"
[ ! -x "$BUSYBOX" ] && BUSYBOX="$(which busybox 2>/dev/null)"

log() {
    echo "[$(date '+%m-%d %H:%M:%S')] $1" >> "$LOG_FILE"
}

get_config_val() {
    key="$1"
    default="$2"
    if [ -f "$CONF_FILE" ]; then
        v=$(grep "^${key}=" "$CONF_FILE" | cut -d'=' -f2)
        [ -n "$v" ] && echo "$v" && return
    fi
    echo "$default"
}

handle_event() {
    [ ! -f "$SYS_OUT" ] && return

    # Read sysmon status
    focused_line=$(grep "^focused_app" "$SYS_OUT" 2>/dev/null)
    screen_line=$(grep "^screen_awake" "$SYS_OUT" 2>/dev/null)
    bat_saver_line=$(grep "^battery_saver" "$SYS_OUT" 2>/dev/null)

    [ -z "$focused_line" ] && return

    pkg=$(echo "$focused_line" | awk '{print $2}')
    screen_awake=$(echo "$screen_line" | awk '{print $2}')
    bat_saver=$(echo "$bat_saver_line" | awk '{print $2}')
    [ -z "$bat_saver" ] && bat_saver=$(settings get global low_power 2>/dev/null || echo 0)

    prev_state="none"
    [ -f "$STATE_FILE" ] && prev_state=$(cat "$STATE_FILE" 2>/dev/null)

    # 1. ROM Battery Saver Handling (Priority over games/normal)
    # Mode Battery "HANYA" aktif ketika mode hemat baterai bawaan ROM AOSP aktif!
    if [ "$bat_saver" = "1" ]; then
        if [ "$prev_state" != "battery_saver" ]; then
            last_prof=$("$CTRL" profile get 2>/dev/null || echo "balanced")
            if [ "$last_prof" != "battery" ]; then
                echo "$last_prof" > "$CONF_DIR/last_normal_profile"
            fi
            log "ROM Battery Saver ON -> Applying BATTERY mode"
            "$CTRL" profile battery >/dev/null 2>&1
            echo "battery_saver" > "$STATE_FILE"
        fi
        return
    elif [ "$prev_state" = "battery_saver" ]; then
        # ROM Battery Saver was just turned OFF
        last_prof="balanced"
        if [ -f "$CONF_DIR/last_normal_profile" ]; then
            last_prof=$(cat "$CONF_DIR/last_normal_profile" 2>/dev/null)
            [ -z "$last_prof" ] && last_prof="balanced"
        fi
        log "ROM Battery Saver OFF -> Restoring $last_prof"
        "$CTRL" profile "$last_prof" >/dev/null 2>&1
        echo "normal" > "$STATE_FILE"
    fi

    # 2. Screen Off Handling
    if [ "$screen_awake" = "0" ]; then
        if [ "$prev_state" = "game" ]; then
            log "Screen turned off during game -> Setting balanced"
            "$CTRL" profile balanced >/dev/null 2>&1
            echo "screen_off" > "$STATE_FILE"
        fi
        return
    fi

    # 3. Auto Game Detection
    auto_game=$(get_config_val "AUTO_GAME" "1")
    [ "$auto_game" = "0" ] && return

    is_game=0
    if [ -n "$pkg" ] && [ -f "$GAMELIST" ]; then
        if grep -F -x -q "$pkg" "$GAMELIST" 2>/dev/null; then
            is_game=1
        fi
    fi

    if [ "$is_game" -eq 1 ]; then
        # Active application is a GAME!
        if [ "$prev_state" != "game" ]; then
            last_prof=$("$CTRL" profile get 2>/dev/null || echo "balanced")
            if [ "$last_prof" != "benchmark" ] && [ "$last_prof" != "performance" ] && [ "$last_prof" != "battery" ]; then
                echo "$last_prof" > "$CONF_DIR/last_normal_profile"
            fi

            perf_lite=$(get_config_val "PERF_LITE" "1")

            if [ "$perf_lite" = "1" ]; then
                log "Game opened: $pkg -> Applying PERFORMANCE mode (Dynamic scaling, 585MHz GPU cap)"
                "$CTRL" profile performance >/dev/null 2>&1
            else
                log "Game opened: $pkg -> Applying BENCHMARK mode (100% full hardware potential)"
                "$CTRL" profile benchmark >/dev/null 2>&1
            fi

            echo "game" > "$STATE_FILE"
            echo "$pkg" > "$CONF_DIR/active_game"
        fi
    else
        # Active application is NOT a game
        if [ "$prev_state" = "game" ] || [ "$prev_state" = "screen_off" ]; then
            last_prof="balanced"
            if [ -f "$CONF_DIR/last_normal_profile" ]; then
                last_prof=$(cat "$CONF_DIR/last_normal_profile" 2>/dev/null)
                [ -z "$last_prof" ] && last_prof="balanced"
            fi

            log "Exited game ($pkg in foreground) -> Restoring $last_prof"
            "$CTRL" profile "$last_prof" >/dev/null 2>&1
            echo "normal" > "$STATE_FILE"
            rm -f "$CONF_DIR/active_game"
        fi
    fi
}

start_daemon() {
    stop_daemon

    mkdir -p "$CONF_DIR"
    rm -f "$LOCK_FILE"
    echo "normal" > "$STATE_FILE"

    log "Starting E404 Controller Daemon..."

    APK="$MODDIR/bin/system_monitor.apk"
    if [ ! -f "$APK" ]; then
        log "ERROR: system_monitor.apk not found at $APK"
        return 1
    fi

    nohup app_process -Djava.class.path="$APK" / \
        --nice-name=E404SysMon com.rem01gaming.systemmonitor.MainKt \
        "$SYS_OUT" "$LOCK_FILE" >/dev/null 2>&1 &

    sleep 1

    if [ -x "$BUSYBOX" ]; then
        DAEMON_BIN="$MODDIR/bin/e404-daemon"
        nohup "$BUSYBOX" inotifyd "$DAEMON_BIN" "$SYS_OUT:cw" >/dev/null 2>&1 &
        inotify_pid=$!
        echo "$inotify_pid" > "$CONF_DIR/inotifyd.pid"
        log "Watcher started with inotifyd (PID: $inotify_pid, 0% CPU)"
    fi
}

stop_daemon() {
    killall -9 E404SysMon 2>/dev/null || true
    if [ -f "$CONF_DIR/inotifyd.pid" ]; then
        kpid=$(cat "$CONF_DIR/inotifyd.pid" 2>/dev/null)
        [ -n "$kpid" ] && kill -9 "$kpid" 2>/dev/null || true
        rm -f "$CONF_DIR/inotifyd.pid"
    fi
    killall -9 inotifyd 2>/dev/null || true
    rm -f "$LOCK_FILE"
    echo "stopped" > "$STATE_FILE"
    log "E404 Controller Daemon stopped."
}

status_daemon() {
    if pgrep -f E404SysMon >/dev/null; then
        echo "running"
    else
        echo "stopped"
    fi
}

# Inotifyd callback handler (invoked as: e404-daemon <event> <file>)
if [ "$1" = "w" ] || [ "$1" = "c" ] || [ "$1" = "m" ] || [ "$1" = "e404_event" ]; then
    handle_event
    exit 0
fi

case "$1" in
    start)
        start_daemon
        ;;
    stop)
        stop_daemon
        ;;
    restart)
        start_daemon
        ;;
    status)
        status_daemon
        ;;
    trigger)
        handle_event
        ;;
    *)
        echo "Usage: e404-daemon {start|stop|restart|status|trigger}"
        exit 1
        ;;
esac

exit 0
