#!/system/bin/sh
#
# E404 Controller - Unified Hardware, BORE & Kernel Optimizer
# Designed for Poco X3 Pro (SM8150 / vayu)
#

# Determine Module Directory
if [ -d "/data/adb/modules/e404_controller" ]; then
    MODDIR="/data/adb/modules/e404_controller"
else
    MODDIR="$(cd "$(dirname "$0")/.." 2>/dev/null && pwd)"
fi

CONF_DIR="$MODDIR/config"
PROFILE_FILE="$CONF_DIR/current_profile"
SETTINGS_FILE="$CONF_DIR/e404.conf"
GAMELIST="$CONF_DIR/gamelist.txt"

mkdir -p "$CONF_DIR" 2>/dev/null

write_node() {
    val="$1"
    node="$2"
    if [ -w "$node" ]; then
        echo "$val" > "$node" 2>/dev/null || true
    fi
}

show_notify() {
    msg="$1"
    cmd notification post -S bigtext -t "E404 Controller" "e404_mode" "$msg" >/dev/null 2>&1 &
}

get_conf() {
    key="$1"
    default="$2"
    if [ -f "$SETTINGS_FILE" ]; then
        v=$(grep "^${key}=" "$SETTINGS_FILE" | cut -d'=' -f2)
        [ -n "$v" ] && echo "$v" && return
    fi
    echo "$default"
}

set_conf() {
    key="$1"
    val="$2"
    if [ ! -f "$SETTINGS_FILE" ]; then
        echo "${key}=${val}" > "$SETTINGS_FILE"
    elif grep -q "^${key}=" "$SETTINGS_FILE"; then
        sed -i "s|^${key}=.*|${key}=${val}|" "$SETTINGS_FILE"
    else
        echo "${key}=${val}" >> "$SETTINGS_FILE"
    fi
}

update_module_prop() {
    prof="$1"
    prop="$MODDIR/module.prop"
    tag="[Active: $(echo "$prof" | tr 'a-z' 'A-Z' | tr '_' ' ')]"
    cat <<EOF > "$prop"
id=e404_controller
name=E404 Controller (SM8150)
version=v1.2.0
versionCode=10200
author=E404
description=Unified SM8150 controller with BORE 7.0.1, uclamp tuning, auto-game daemon & Material 3 WebUI. $tag
EOF
}

apply_benchmark() {
    # Thermal: Gaming unconstrained
    write_node 10 /sys/devices/virtual/thermal/thermal_message/sconfig
    write_node 0 /sys/devices/virtual/thermal/thermal_message/balance_mode

    # CPU Frequencies & Schedutil (100% full potential unleashed)
    write_node 1804800 /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq
    write_node 1171200 /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq
    write_node 500 /sys/devices/system/cpu/cpufreq/policy0/schedutil/rate_limit_us
    write_node 8 /sys/devices/system/cpu/cpufreq/policy0/schedutil/response_time_ms

    write_node 2419200 /sys/devices/system/cpu/cpufreq/policy4/scaling_max_freq
    write_node 1382400 /sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq
    write_node 500 /sys/devices/system/cpu/cpufreq/policy4/schedutil/rate_limit_us
    write_node 20 /sys/devices/system/cpu/cpufreq/policy4/schedutil/response_time_ms

    write_node 2956800 /sys/devices/system/cpu/cpufreq/policy7/scaling_max_freq
    write_node 1516800 /sys/devices/system/cpu/cpufreq/policy7/scaling_min_freq
    write_node 500 /sys/devices/system/cpu/cpufreq/policy7/schedutil/rate_limit_us
    write_node 30 /sys/devices/system/cpu/cpufreq/policy7/schedutil/response_time_ms

    # uclamp tuning (benchmark)
    write_node 50.00 /dev/cpuctl/top-app/cpu.uclamp.min
    write_node max /dev/cpuctl/top-app/cpu.uclamp.max
    write_node 1 /dev/cpuctl/top-app/cpu.uclamp.latency_sensitive
    write_node 20.00 /dev/cpuctl/background/cpu.uclamp.max

    # GPU: Uncapped 692 MHz OPP0, floor OPP4 (427 MHz)
    write_node 0 /sys/class/kgsl/kgsl-3d0/max_pwrlevel
    write_node 4 /sys/class/kgsl/kgsl-3d0/min_pwrlevel
    write_node 80 /sys/class/kgsl/kgsl-3d0/idle_timer
    write_node 1 /sys/class/kgsl/kgsl-3d0/bus_split

    # BORE 7.0.1 Scheduler
    write_node 1 /proc/sys/kernel/sched_bore
    write_node 2 /proc/sys/kernel/sched_burst_protect_slice_lv
    write_node 1200 /proc/sys/kernel/sched_burst_penalty_scale
    write_node 1 /proc/sys/kernel/sched_burst_smoothness

    # UFS Storage 3.1
    for q in /sys/block/sd[a-f]/queue; do
        write_node 512 "$q/read_ahead_kb"
        write_node 0 "$q/iostats"
        write_node 2 "$q/nomerges"
        write_node 0 "$q/add_random"
        write_node 2 "$q/rq_affinity"
    done

    # VM Memory
    write_node 80 /proc/sys/vm/vfs_cache_pressure

    # Lyb Touch
    write_node 1 /sys/kernel/e404/lyb/touch_game_mode

    echo "benchmark" > "$PROFILE_FILE"
    update_module_prop "benchmark"
    show_notify "🚀 Mode BENCHMARK Aktif (100% Potensi Maksimal)"
}

apply_performance() {
    # Thermal: Gaming profile
    write_node 10 /sys/devices/virtual/thermal/thermal_message/sconfig
    write_node 0 /sys/devices/virtual/thermal/thermal_message/balance_mode

    # CPU: Dynamic Scaling - Scales when load demands, drops when smooth!
    write_node 1804800 /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq
    write_node 883200 /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq
    write_node 2000 /sys/devices/system/cpu/cpufreq/policy0/schedutil/rate_limit_us
    write_node 13 /sys/devices/system/cpu/cpufreq/policy0/schedutil/response_time_ms

    write_node 2150400 /sys/devices/system/cpu/cpufreq/policy4/scaling_max_freq
    write_node 825600 /sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq
    write_node 2000 /sys/devices/system/cpu/cpufreq/policy4/schedutil/rate_limit_us
    write_node 40 /sys/devices/system/cpu/cpufreq/policy4/schedutil/response_time_ms

    write_node 2457600 /sys/devices/system/cpu/cpufreq/policy7/scaling_max_freq
    write_node 844800 /sys/devices/system/cpu/cpufreq/policy7/scaling_min_freq
    write_node 2000 /sys/devices/system/cpu/cpufreq/policy7/schedutil/rate_limit_us
    write_node 60 /sys/devices/system/cpu/cpufreq/policy7/schedutil/response_time_ms

    # uclamp dynamic scaling (eliminates micro-stutters without locking at 100%)
    write_node 15.00 /dev/cpuctl/top-app/cpu.uclamp.min
    write_node max /dev/cpuctl/top-app/cpu.uclamp.max
    write_node 1 /dev/cpuctl/top-app/cpu.uclamp.latency_sensitive
    write_node 25.00 /dev/cpuctl/background/cpu.uclamp.max

    # GPU: Cap 585 MHz (OPP2) to prevent severe 692MHz DDR2133 battery drain, drops to 150MHz (OPP7) when light!
    write_node 2 /sys/class/kgsl/kgsl-3d0/max_pwrlevel
    write_node 7 /sys/class/kgsl/kgsl-3d0/min_pwrlevel
    write_node 40 /sys/class/kgsl/kgsl-3d0/idle_timer
    write_node 1 /sys/class/kgsl/kgsl-3d0/bus_split

    # BORE 7.0.1 Scheduler
    write_node 1 /proc/sys/kernel/sched_bore
    write_node 1 /proc/sys/kernel/sched_burst_protect_slice_lv
    write_node 1280 /proc/sys/kernel/sched_burst_penalty_scale
    write_node 1 /proc/sys/kernel/sched_burst_smoothness

    # UFS Storage 3.1
    for q in /sys/block/sd[a-f]/queue; do
        write_node 256 "$q/read_ahead_kb"
        write_node 0 "$q/iostats"
        write_node 1 "$q/nomerges"
        write_node 0 "$q/add_random"
        write_node 2 "$q/rq_affinity"
    done

    # VM Memory
    write_node 100 /proc/sys/vm/vfs_cache_pressure

    # Lyb Touch
    write_node 1 /sys/kernel/e404/lyb/touch_game_mode

    echo "performance" > "$PROFILE_FILE"
    update_module_prop "performance"
    show_notify "🎮 Mode PERFORMANCE Aktif (Dynamic Scaling Cerdas)"
}

apply_balanced() {
    # Thermal: Stock automatic
    write_node 0 /sys/devices/virtual/thermal/thermal_message/sconfig
    write_node 0 /sys/devices/virtual/thermal/thermal_message/balance_mode

    # CPU: Full stock dynamic range
    write_node 1804800 /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq
    write_node 883200 /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq
    write_node 4000 /sys/devices/system/cpu/cpufreq/policy0/schedutil/rate_limit_us
    write_node 13 /sys/devices/system/cpu/cpufreq/policy0/schedutil/response_time_ms

    write_node 2419200 /sys/devices/system/cpu/cpufreq/policy4/scaling_max_freq
    write_node 825600 /sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq
    write_node 4000 /sys/devices/system/cpu/cpufreq/policy4/schedutil/rate_limit_us
    write_node 61 /sys/devices/system/cpu/cpufreq/policy4/schedutil/response_time_ms

    write_node 2956800 /sys/devices/system/cpu/cpufreq/policy7/scaling_max_freq
    write_node 844800 /sys/devices/system/cpu/cpufreq/policy7/scaling_min_freq
    write_node 4000 /sys/devices/system/cpu/cpufreq/policy7/schedutil/rate_limit_us
    write_node 76 /sys/devices/system/cpu/cpufreq/policy7/schedutil/response_time_ms

    # uclamp stock
    write_node 0.00 /dev/cpuctl/top-app/cpu.uclamp.min
    write_node max /dev/cpuctl/top-app/cpu.uclamp.max
    write_node 0 /dev/cpuctl/top-app/cpu.uclamp.latency_sensitive
    write_node 30.00 /dev/cpuctl/background/cpu.uclamp.max

    # GPU: Cap to 585 MHz (OPP2), full idle to OPP7 (150 MHz)
    write_node 2 /sys/class/kgsl/kgsl-3d0/max_pwrlevel
    write_node 7 /sys/class/kgsl/kgsl-3d0/min_pwrlevel
    write_node 24 /sys/class/kgsl/kgsl-3d0/idle_timer
    write_node 0 /sys/class/kgsl/kgsl-3d0/bus_split

    # BORE 7.0.1 Scheduler
    write_node 1 /proc/sys/kernel/sched_bore
    write_node 1 /proc/sys/kernel/sched_burst_protect_slice_lv
    write_node 1280 /proc/sys/kernel/sched_burst_penalty_scale
    write_node 1 /proc/sys/kernel/sched_burst_smoothness

    # UFS Storage 3.1
    for q in /sys/block/sd[a-f]/queue; do
        write_node 128 "$q/read_ahead_kb"
        write_node 1 "$q/iostats"
        write_node 0 "$q/nomerges"
        write_node 1 "$q/add_random"
        write_node 1 "$q/rq_affinity"
    done

    # VM Memory
    write_node 100 /proc/sys/vm/vfs_cache_pressure

    # Lyb Touch
    write_node 0 /sys/kernel/e404/lyb/touch_game_mode

    echo "balanced" > "$PROFILE_FILE"
    update_module_prop "balanced"
    show_notify "⚖️ Mode BALANCED Aktif"
}

apply_battery() {
    # Thermal: ROM Power saving
    write_node 1 /sys/devices/virtual/thermal/thermal_message/sconfig
    write_node 1 /sys/devices/virtual/thermal/thermal_message/balance_mode

    # CPU: Sweet-spot minimums (No UI lag, but strictly restrained)
    write_node 1344000 /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq
    write_node 883200 /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq
    write_node 8000 /sys/devices/system/cpu/cpufreq/policy0/schedutil/rate_limit_us

    write_node 1478400 /sys/devices/system/cpu/cpufreq/policy4/scaling_max_freq
    write_node 825600 /sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq
    write_node 8000 /sys/devices/system/cpu/cpufreq/policy4/schedutil/rate_limit_us

    write_node 1401600 /sys/devices/system/cpu/cpufreq/policy7/scaling_max_freq
    write_node 844800 /sys/devices/system/cpu/cpufreq/policy7/scaling_min_freq
    write_node 8000 /sys/devices/system/cpu/cpufreq/policy7/schedutil/rate_limit_us

    # uclamp power saving
    write_node 0.00 /dev/cpuctl/top-app/cpu.uclamp.min
    write_node 50.00 /dev/cpuctl/top-app/cpu.uclamp.max
    write_node 0 /dev/cpuctl/top-app/cpu.uclamp.latency_sensitive
    write_node 15.00 /dev/cpuctl/background/cpu.uclamp.max

    # GPU: Cap to 427 MHz (OPP4), full idle OPP7 (150 MHz)
    write_node 4 /sys/class/kgsl/kgsl-3d0/max_pwrlevel
    write_node 7 /sys/class/kgsl/kgsl-3d0/min_pwrlevel
    write_node 16 /sys/class/kgsl/kgsl-3d0/idle_timer
    write_node 0 /sys/class/kgsl/kgsl-3d0/bus_split

    # BORE 7.0.1 Scheduler
    write_node 1 /proc/sys/kernel/sched_bore
    write_node 0 /proc/sys/kernel/sched_burst_protect_slice_lv
    write_node 1600 /proc/sys/kernel/sched_burst_penalty_scale
    write_node 1 /proc/sys/kernel/sched_burst_smoothness

    # UFS Storage 3.1
    for q in /sys/block/sd[a-f]/queue; do
        write_node 64 "$q/read_ahead_kb"
        write_node 1 "$q/iostats"
        write_node 0 "$q/nomerges"
        write_node 1 "$q/add_random"
        write_node 1 "$q/rq_affinity"
    done

    # VM Memory
    write_node 120 /proc/sys/vm/vfs_cache_pressure

    # Lyb Touch
    write_node 0 /sys/kernel/e404/lyb/touch_game_mode

    echo "battery" > "$PROFILE_FILE"
    update_module_prop "battery"
    show_notify "🔋 Mode BATTERY Aktif (Hemat Daya ROM)"
}

set_bypass() {
    state="$1"
    if [ "$state" = "1" ] || [ "$state" = "on" ] || [ "$state" = "enable" ]; then
        write_node 1 /sys/class/power_supply/battery/input_suspend
        set_conf "BYPASS" "1"
        echo "Bypass charging ENABLED"
        show_notify "⚡ Bypass Charging AKTIF"
    else
        write_node 0 /sys/class/power_supply/battery/input_suspend
        set_conf "BYPASS" "0"
        echo "Bypass charging DISABLED"
        show_notify "⚡ Bypass Charging NONAKTIF"
    fi
}

set_fastcharge() {
    state="$1"
    if [ "$state" = "1" ] || [ "$state" = "on" ] || [ "$state" = "enable" ]; then
        write_node 1 /sys/kernel/fast_charge/force_fast_charge
        set_conf "FASTCHARGE" "1"
        echo "6A Fast Charge override ENABLED"
    else
        write_node 0 /sys/kernel/fast_charge/force_fast_charge
        set_conf "FASTCHARGE" "0"
        echo "6A Fast Charge override DISABLED"
    fi
}

set_lyb() {
    state="$1"
    if [ "$state" = "1" ] || [ "$state" = "on" ] || [ "$state" = "enable" ]; then
        write_node 1 /sys/kernel/e404/lyb/touch_game_mode
        set_conf "LYB" "1"
        echo "Lyb Game Touch mode ENABLED"
    else
        write_node 0 /sys/kernel/e404/lyb/touch_game_mode
        set_conf "LYB" "0"
        echo "Lyb Game Touch mode DISABLED"
    fi
}

set_perflite() {
    state="$1"
    if [ "$state" = "1" ] || [ "$state" = "on" ] || [ "$state" = "enable" ]; then
        set_conf "PERF_LITE" "1"
        echo "Performance Lite mode ENABLED"
    else
        set_conf "PERF_LITE" "0"
        echo "Performance Lite mode DISABLED"
    fi
}

set_autogame() {
    state="$1"
    if [ "$state" = "1" ] || [ "$state" = "on" ] || [ "$state" = "enable" ]; then
        set_conf "AUTO_GAME" "1"
        echo "Auto-Game Detection ENABLED"
    else
        set_conf "AUTO_GAME" "0"
        echo "Auto-Game Detection DISABLED"
    fi
}

add_game_package() {
    pkg="$1"
    [ -z "$pkg" ] && return
    mkdir -p "$CONF_DIR"
    touch "$GAMELIST"
    if ! grep -F -x -q "$pkg" "$GAMELIST"; then
        echo "$pkg" >> "$GAMELIST"
        echo "Added $pkg to gamelist"
    else
        echo "$pkg already exists in gamelist"
    fi
}

remove_game_package() {
    pkg="$1"
    [ -z "$pkg" ] && return
    if [ -f "$GAMELIST" ]; then
        grep -F -v -x "$pkg" "$GAMELIST" > "$GAMELIST.tmp" && mv "$GAMELIST.tmp" "$GAMELIST"
        echo "Removed $pkg from gamelist"
    fi
}

get_status_json() {
    if [ -f "$PROFILE_FILE" ]; then
        cur_prof=$(cat "$PROFILE_FILE" 2>/dev/null | tr -d '[:space:]')
    else
        cur_prof="balanced"
    fi

    # CPU Live Clocks
    c0_cur=$(cat /sys/devices/system/cpu/cpufreq/policy0/scaling_cur_freq 2>/dev/null || echo 0)
    c0_max=$(cat /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq 2>/dev/null || echo 1804800)
    c4_cur=$(cat /sys/devices/system/cpu/cpufreq/policy4/scaling_cur_freq 2>/dev/null || echo 0)
    c4_max=$(cat /sys/devices/system/cpu/cpufreq/policy4/scaling_max_freq 2>/dev/null || echo 2419200)
    c7_cur=$(cat /sys/devices/system/cpu/cpufreq/policy7/scaling_cur_freq 2>/dev/null || echo 0)
    c7_max=$(cat /sys/devices/system/cpu/cpufreq/policy7/scaling_max_freq 2>/dev/null || echo 2956800)

    # Temperatures
    cpu_t_raw=$(cat /sys/class/thermal/thermal_zone1/temp 2>/dev/null || echo 45000)
    cpu_temp=$(awk "BEGIN {printf \"%.1f\", $cpu_t_raw / 1000}")

    gpu_t_raw=$(cat /sys/class/thermal/thermal_zone15/temp 2>/dev/null || echo 40000)
    gpu_temp=$(awk "BEGIN {printf \"%.1f\", $gpu_t_raw / 1000}")

    # GPU
    gpu_clk_raw=$(cat /sys/class/kgsl/kgsl-3d0/gpuclk 2>/dev/null || echo 150000000)
    gpu_mhz=$((gpu_clk_raw / 1000000))
    gpu_max_pwr=$(cat /sys/class/kgsl/kgsl-3d0/max_pwrlevel 2>/dev/null || echo 0)
    gpu_min_pwr=$(cat /sys/class/kgsl/kgsl-3d0/min_pwrlevel 2>/dev/null || echo 7)

    # Battery
    bat_cap=$(cat /sys/class/power_supply/battery/capacity 2>/dev/null || echo 0)
    bat_curr_raw=$(cat /sys/class/power_supply/battery/current_now 2>/dev/null || echo 0)
    bat_curr_ma=$((bat_curr_raw / 1000))
    bat_t_raw=$(cat /sys/class/power_supply/battery/temp 2>/dev/null || echo 300)
    bat_temp=$(awk "BEGIN {printf \"%.1f\", $bat_t_raw / 10}")
    bat_status=$(cat /sys/class/power_supply/battery/status 2>/dev/null || echo "Unknown")

    # Features
    input_suspend=$(cat /sys/class/power_supply/battery/input_suspend 2>/dev/null || echo 0)
    fast_charge=$(cat /sys/kernel/fast_charge/force_fast_charge 2>/dev/null || echo 0)
    lyb_touch=$(cat /sys/kernel/e404/lyb/touch_game_mode 2>/dev/null || echo 0)
    bore_status=$(cat /proc/sys/kernel/sched_bore 2>/dev/null || echo 0)
    bore_protect=$(cat /proc/sys/kernel/sched_burst_protect_slice_lv 2>/dev/null || echo 0)
    ufs_ra=$(cat /sys/block/sda/queue/read_ahead_kb 2>/dev/null || echo 128)

    # uclamp status
    uclamp_top_min=$(cat /dev/cpuctl/top-app/cpu.uclamp.min 2>/dev/null || echo "0.00")
    uclamp_bg_max=$(cat /dev/cpuctl/background/cpu.uclamp.max 2>/dev/null || echo "30.00")

    # Daemon & Auto-Game Toggles
    perf_lite=$(get_conf "PERF_LITE" "1")
    auto_game=$(get_conf "AUTO_GAME" "1")
    daemon_run=0
    pgrep -f E404SysMon >/dev/null 2>&1 && daemon_run=1
    active_game=""
    [ -f "$CONF_DIR/active_game" ] && active_game=$(cat "$CONF_DIR/active_game" 2>/dev/null)
    game_count=0
    [ -f "$GAMELIST" ] && game_count=$(grep -c -v '^[[:space:]]*$' "$GAMELIST" 2>/dev/null || echo 0)

    # ROM Low Power Status
    rom_battery_saver=$(settings get global low_power 2>/dev/null || echo 0)
    [ "$rom_battery_saver" != "1" ] && rom_battery_saver=0

    # Format JSON
    cat <<EOF
{
  "profile": "$cur_prof",
  "device": "Xiaomi Poco X3 Pro (vayu)",
  "soc": "Snapdragon 860 (SM8150)",
  "kernel": "Linux 4.19.404R",
  "bore_version": "7.0.1",
  "bore_enabled": $bore_status,
  "bore_protect_slice": $bore_protect,
  "uclamp_top_min": "$uclamp_top_min",
  "uclamp_bg_max": "$uclamp_bg_max",
  "cpu": {
    "silver_cur": $c0_cur,
    "silver_max": $c0_max,
    "gold_cur": $c4_cur,
    "gold_max": $c4_max,
    "prime_cur": $c7_cur,
    "prime_max": $c7_max,
    "temp": $cpu_temp
  },
  "gpu": {
    "cur_freq_mhz": $gpu_mhz,
    "max_pwrlevel": $gpu_max_pwr,
    "min_pwrlevel": $gpu_min_pwr,
    "temp": $gpu_temp
  },
  "battery": {
    "capacity": $bat_cap,
    "current_ma": $bat_curr_ma,
    "temp": $bat_temp,
    "status": "$bat_status",
    "bypass_charging": $input_suspend,
    "force_fast_charge": $fast_charge,
    "rom_battery_saver": $rom_battery_saver
  },
  "lyb_touch": $lyb_touch,
  "ufs_read_ahead_kb": $ufs_ra,
  "auto_game": $auto_game,
  "perf_lite": $perf_lite,
  "daemon_running": $daemon_run,
  "active_game": "$active_game",
  "game_count": $game_count
}
EOF
}

case "$1" in
    profile)
        case "$2" in
            benchmark)
                apply_benchmark
                echo "Profile set: BENCHMARK"
                ;;
            performance)
                apply_performance
                echo "Profile set: PERFORMANCE"
                ;;
            game_lite)
                # Backward compatibility alias
                apply_performance
                echo "Profile set: PERFORMANCE"
                ;;
            balanced)
                apply_balanced
                echo "Profile set: BALANCED"
                ;;
            battery)
                apply_battery
                echo "Profile set: BATTERY"
                ;;
            get)
                if [ -f "$PROFILE_FILE" ]; then
                    cat "$PROFILE_FILE"
                else
                    echo "balanced"
                fi
                ;;
            *)
                echo "Usage: e404-ctrl profile [benchmark|performance|balanced|battery|get]"
                exit 1
                ;;
        esac
        ;;
    game)
        case "$2" in
            add)
                add_game_package "$3"
                ;;
            remove|del)
                remove_game_package "$3"
                ;;
            list)
                [ -f "$GAMELIST" ] && cat "$GAMELIST"
                ;;
            has)
                if [ -f "$GAMELIST" ] && grep -F -x -q "$3" "$GAMELIST"; then
                    echo "1"
                else
                    echo "0"
                fi
                ;;
            *)
                echo "Usage: e404-ctrl game [add|remove|list|has] <package>"
                ;;
        esac
        ;;
    perflite)
        case "$2" in
            1|on|enable) set_perflite 1 ;;
            0|off|disable) set_perflite 0 ;;
            toggle)
                cur=$(get_conf "PERF_LITE" "1")
                [ "$cur" = "1" ] && set_perflite 0 || set_perflite 1
                ;;
            status) get_conf "PERF_LITE" "1" ;;
            *) echo "Usage: e404-ctrl perflite [on|off|toggle|status]" ;;
        esac
        ;;
    autogame)
        case "$2" in
            1|on|enable) set_autogame 1 ;;
            0|off|disable) set_autogame 0 ;;
            toggle)
                cur=$(get_conf "AUTO_GAME" "1")
                [ "$cur" = "1" ] && set_autogame 0 || set_autogame 1
                ;;
            status) get_conf "AUTO_GAME" "1" ;;
            *) echo "Usage: e404-ctrl autogame [on|off|toggle|status]" ;;
        esac
        ;;
    daemon)
        case "$2" in
            start|stop|restart|status)
                "$MODDIR/bin/e404-daemon" "$2"
                ;;
            *)
                echo "Usage: e404-ctrl daemon [start|stop|restart|status]"
                ;;
        esac
        ;;
    bypass)
        case "$2" in
            1|on|enable) set_bypass 1 ;;
            0|off|disable) set_bypass 0 ;;
            toggle)
                cur=$(cat /sys/class/power_supply/battery/input_suspend 2>/dev/null || echo 0)
                [ "$cur" = "1" ] && set_bypass 0 || set_bypass 1
                ;;
            status) cat /sys/class/power_supply/battery/input_suspend 2>/dev/null || echo 0 ;;
            *) echo "Usage: e404-ctrl bypass [on|off|toggle|status]" ; exit 1 ;;
        esac
        ;;
    fastcharge)
        case "$2" in
            1|on|enable) set_fastcharge 1 ;;
            0|off|disable) set_fastcharge 0 ;;
            toggle)
                cur=$(cat /sys/kernel/fast_charge/force_fast_charge 2>/dev/null || echo 0)
                [ "$cur" = "1" ] && set_fastcharge 0 || set_fastcharge 1
                ;;
            status) cat /sys/kernel/fast_charge/force_fast_charge 2>/dev/null || echo 0 ;;
            *) echo "Usage: e404-ctrl fastcharge [on|off|toggle|status]" ; exit 1 ;;
        esac
        ;;
    lyb)
        case "$2" in
            1|on|enable) set_lyb 1 ;;
            0|off|disable) set_lyb 0 ;;
            toggle)
                cur=$(cat /sys/kernel/e404/lyb/touch_game_mode 2>/dev/null || echo 0)
                [ "$cur" = "1" ] && set_lyb 0 || set_lyb 1
                ;;
            status) cat /sys/kernel/e404/lyb/touch_game_mode 2>/dev/null || echo 0 ;;
            *) echo "Usage: e404-ctrl lyb [on|off|toggle|status]" ; exit 1 ;;
        esac
        ;;
    toast|notify)
        show_notify "$2"
        ;;
    status)
        get_status_json
        ;;
    apply)
        if [ -f "$PROFILE_FILE" ]; then
            p=$(cat "$PROFILE_FILE" 2>/dev/null)
            "$0" profile "$p"
        else
            "$0" profile balanced
        fi
        ;;
    version|-v|--version)
        echo "E404 Controller v1.2.0 (SM8150 / Poco X3 Pro)"
        ;;
    *)
        echo "E404 Controller CLI"
        echo "Usage: e404-ctrl <command> [args]"
        echo ""
        echo "Commands:"
        echo "  profile <benchmark|performance|balanced|battery|get>"
        echo "  game <add|remove|list|has> [package]"
        echo "  perflite <on|off|toggle|status>"
        echo "  autogame <on|off|toggle|status>"
        echo "  daemon <start|stop|restart|status>"
        echo "  bypass <on|off|toggle|status>"
        echo "  fastcharge <on|off|toggle|status>"
        echo "  lyb <on|off|toggle|status>"
        echo "  notify <message>"
        echo "  status       (Print JSON system state for WebUI)"
        echo "  apply        (Reapply active profile and settings)"
        echo "  version      (Print version)"
        ;;
esac
exit 0
